---
- name: Configure MongoDB database server
  hosts: db
  become: true
  vars_files:
    - group_vars/all.yml
  tasks:
    - name: Install required packages
      ansible.builtin.apt:
        name:
          - gnupg
          - curl
          - ca-certificates
        state: present
        update_cache: true

    - name: Add MongoDB 7.0 signing key
      ansible.builtin.shell: |
        set -o pipefail
        curl -fsSL https://pgp.mongodb.com/server-7.0.asc | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg
      args:
        creates: /usr/share/keyrings/mongodb-server-7.0.gpg
        executable: /bin/bash

    - name: Add MongoDB 7.0 repository
      ansible.builtin.apt_repository:
        repo: "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse"
        filename: mongodb-org-7.0
        state: present

    - name: Install MongoDB
      ansible.builtin.apt:
        name: mongodb-org
        state: present
        update_cache: true

    - name: Configure MongoDB to listen on localhost and private interface
      ansible.builtin.template:
        src: templates/mongod.conf.j2
        dest: /etc/mongod.conf
        owner: root
        group: root
        mode: "0644"
      notify: Restart MongoDB

    - name: Ensure MongoDB is enabled and started
      ansible.builtin.systemd:
        name: mongod
        enabled: true
        state: started

    - name: Apply MongoDB configuration before creating credentials
      ansible.builtin.meta: flush_handlers

    - name: Wait for MongoDB to accept connections
      ansible.builtin.wait_for:
        port: 27017
        host: 127.0.0.1
        timeout: 90

    - name: Create application database user (MongoDB localhost exception applies on first setup)
      ansible.builtin.shell: |
        mongosh --quiet admin --eval '
          if (db.getUser("{{ mongo_app_user }}") === null) {
            db.createUser({
              user: "{{ mongo_app_user }}",
              pwd: "{{ mongo_app_password | replace("\\", "\\\\") | replace("\"", "\\\"") }}",
              roles: [{ role: "readWrite", db: "{{ mongo_database }}" }]
            });
          }'
      args:
        executable: /bin/bash
      no_log: true
      register: mongo_user_result
      changed_when: "'created' in (mongo_user_result.stdout | default(''))"
      failed_when: mongo_user_result.rc != 0

  handlers:
    - name: Restart MongoDB
      ansible.builtin.systemd:
        name: mongod
        state: restarted

- name: Deploy TravelMemory web and backend
  hosts: web
  become: true
  vars_files:
    - group_vars/all.yml
  tasks:
    - name: Install OS packages
      ansible.builtin.apt:
        name:
          - ca-certificates
          - curl
          - git
          - nginx
          - build-essential
        state: present
        update_cache: true

    - name: Add NodeSource Node.js repository
      ansible.builtin.shell: |
        curl -fsSL https://deb.nodesource.com/setup_{{ node_major }}.x | bash -
      args:
        creates: /etc/apt/sources.list.d/nodesource.list
        executable: /bin/bash

    - name: Install Node.js and npm
      ansible.builtin.apt:
        name: nodejs
        state: present
        update_cache: true

    - name: Create application root
      ansible.builtin.file:
        path: "{{ app_root }}"
        state: directory
        owner: ubuntu
        group: ubuntu
        mode: "0755"

    - name: Clone TravelMemory repository
      ansible.builtin.git:
        repo: "{{ app_repo }}"
        dest: "{{ app_root }}/source"
        version: main
        update: true
      become_user: ubuntu

    - name: Install backend npm dependencies
      ansible.builtin.command: npm install
      args:
        chdir: "{{ app_root }}/source/backend"
      become_user: ubuntu

    - name: Configure backend environment
      ansible.builtin.template:
        src: templates/backend.env.j2
        dest: "{{ app_root }}/source/backend/.env"
        owner: ubuntu
        group: ubuntu
        mode: "0600"
      no_log: true
      notify: Restart TravelMemory

    - name: Install frontend npm dependencies
      ansible.builtin.command: npm install
      args:
        chdir: "{{ app_root }}/source/frontend"
      become_user: ubuntu

    - name: Configure frontend build environment
      ansible.builtin.copy:
        dest: "{{ app_root }}/source/frontend/.env"
        content: |
          REACT_APP_BACKEND_URL=/api
        owner: ubuntu
        group: ubuntu
        mode: "0644"

    - name: Build React frontend
      ansible.builtin.command: npm run build
      args:
        chdir: "{{ app_root }}/source/frontend"
      become_user: ubuntu

    - name: Install frontend build files
      ansible.builtin.copy:
        src: "{{ app_root }}/source/frontend/build/"
        dest: /var/www/travelmemory/
        remote_src: true
        owner: www-data
        group: www-data
        mode: preserve

    - name: Install Nginx site configuration
      ansible.builtin.template:
        src: templates/nginx-travelmemory.conf.j2
        dest: /etc/nginx/sites-available/travelmemory
        owner: root
        group: root
        mode: "0644"
      notify: Reload Nginx

    - name: Enable Nginx site
      ansible.builtin.file:
        src: /etc/nginx/sites-available/travelmemory
        dest: /etc/nginx/sites-enabled/travelmemory
        state: link
      notify: Reload Nginx

    - name: Disable default Nginx site
      ansible.builtin.file:
        path: /etc/nginx/sites-enabled/default
        state: absent
      notify: Reload Nginx

    - name: Install systemd service for backend
      ansible.builtin.template:
        src: templates/travelmemory.service.j2
        dest: /etc/systemd/system/travelmemory.service
        owner: root
        group: root
        mode: "0644"
      notify: Restart TravelMemory

    - name: Enable and start backend
      ansible.builtin.systemd:
        name: travelmemory
        enabled: true
        state: started
        daemon_reload: true

    - name: Ensure Nginx is enabled and started
      ansible.builtin.systemd:
        name: nginx
        enabled: true
        state: started

    - name: Validate Nginx configuration
      ansible.builtin.command: nginx -t
      changed_when: false

  handlers:
    - name: Restart TravelMemory
      ansible.builtin.systemd:
        name: travelmemory
        state: restarted
        daemon_reload: true
      failed_when: false

    - name: Reload Nginx
      ansible.builtin.systemd:
        name: nginx
        state: reloaded
